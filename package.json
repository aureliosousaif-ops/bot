{
  "name": "sousinha-bot-premium",
  "version": "3.0.0",
  "description": "Sousinha Bot Premium — bot multi-dispositivo para WhatsApp, adaptado do MALVIN-XD.",
  "main": "./index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node index.js",
    "start": "pm2 start index.js --deep-monitoring --attach --name sousinha-bot",
    "stop": "pm2 stop sousinha-bot",
    "restart": "pm2 restart sousinha-bot && pm2 logs sousinha-bot",
    "stash": "git stash && git stash drop",
    "test": "node --test",
    "check:syntax": "node scripts/check-syntax.js"
  },
  "keywords": [
    "sousinha-bot",
    "whatsapp-bot",
    "baileys",
    "pt-br",
    "sousinha",
    "mrxd-baileys"
  ],
  "author": "Sousinha Bot",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "*",
    "@hapi/boom": "*",
    "@vitalets/google-translate-api": "^9.2.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "acrcloud": "*",
    "adm-zip": "*",
    "audio-decode": "^2.2.3",
    "axios": "^1.2.5",
    "better-sqlite3": "^12.6.2",
    "body-parser": "latest",
    "dotenv": "*",
    "cheerio": "*",
    "express": "^4.19.2",
    "ffmpeg-static": "*",
    "file-type": "17.1.6",
    "fluent-ffmpeg": "*",
    "form-data": "^4.0.1",
    "fs-extra": "^11.1.0",
    "mrxd-baileys": "1.0.2",
    "malvin-btns": "1.2.0",
    "google-tts-api": "*",
    "jimp": "*",
    "mime-types": "^2.1.35",
    "moment-timezone": "^0.5.45",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "pg": "*",
    "pino": "^7.0.5",
    "pm2": "latest",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "*",
    "sharp": "0.32.6",
    "sqlite3": "5.1.7",
    "wa-sticker-formatter": "*",
    "mongoose": "^8.4.0",
    "yt-search": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "better-sqlite3@12.11.1": true,
    "ffmpeg-static@5.3.0": true,
    "protobufjs@7.6.6": true,
    "sqlite3@5.1.7": true,
    "sharp@0.32.6": true
  }
}
