# Copie este arquivo para .env e preencha apenas suas próprias credenciais. 

SESSION_ID=
USE_REMOTE_SESSION=false
OWNER_NUMBER=
PAIRING_NUMBER=
USE_PAIRING_CODE=false
FORCE_PAIRING_CODE=false
PAIRING_HTTP_TOKEN=
# Números adicionais de superusuário, separados por vírgula. Não publique valores reais.
SUDO_NUMBERS=
OWNER_NAME=Administrador
MODE=public
TIME_ZONE=America/Sao_Paulo
AUTO_READ_STATUS=false
AUTO_LIKE_STATUS=false
# Postress(Get one for free from neon.tech/supabase/render)...will fallback to path: database.db if not provided
DATABASE_URL=
# Chave da API que atende IA, YouTube, Spotify, TikTok, redes sociais e conversores.
# Não é necessário criar chaves separadas enquanto os comandos usarem o Malvin API.
MALVIN_API_KEY=
# Gemini: crie uma chave em https://aistudio.google.com/apikey e mantenha-a somente no Render/.env local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_AUTO_REPLY=true
GEMINI_GROUPS_ONLY=true
# RPG: requer uma URI MongoDB válida; os dados existentes são preservados.
ENABLE_RPG=false
MONGO_URI=
